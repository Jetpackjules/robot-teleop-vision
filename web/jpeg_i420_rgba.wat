;; Exact integer JPEG chroma reconstruction; eight pixels per SIMD iteration.
;; Rounding agrees with the scalar tail for every 8-bit chroma value.
(module
(memory (export "memory") 1 2048)
(func $clip (param $v i32) (result i32) (if (result i32) (i32.lt_s (local.get $v) (i32.const 0)) (then (i32.const 0)) (else (if (result i32) (i32.gt_s (local.get $v) (i32.const 255)) (then (i32.const 255)) (else (local.get $v))))))
(func $sample (param $a i32) (param $b i32) (param $c i32) (param $f i32) (param $bias i32) (result i32)
 (i32.shr_u (i32.add (i32.add (i32.mul (i32.add (i32.mul (i32.load8_u (i32.add (local.get $a) (local.get $c))) (i32.const 3)) (i32.load8_u (i32.add (local.get $b) (local.get $c)))) (i32.const 3)) (i32.add (i32.mul (i32.load8_u (i32.add (local.get $a) (local.get $f))) (i32.const 3)) (i32.load8_u (i32.add (local.get $b) (local.get $f))))) (local.get $bias)) (i32.const 4)))
(func $sample8 (param $a i32) (param $b i32) (param $c i32) (result v128) (local $s v128) (local $n v128) (local $f v128)
(local.set $s (i16x8.add (i16x8.mul (i16x8.extend_low_i8x16_u (v128.load64_zero (i32.sub (i32.add (local.get $a) (local.get $c)) (i32.const 1)))) (v128.const i16x8 3 3 3 3 3 3 3 3)) (i16x8.extend_low_i8x16_u (v128.load64_zero (i32.sub (i32.add (local.get $b) (local.get $c)) (i32.const 1))))))
(local.set $n (i8x16.shuffle 2 3 2 3 4 5 4 5 6 7 6 7 8 9 8 9 (local.get $s) (local.get $s)))
(local.set $f (i8x16.shuffle 0 1 4 5 2 3 6 7 4 5 8 9 6 7 10 11 (local.get $s) (local.get $s)))
(i16x8.sub (i16x8.shr_u (i16x8.add (i16x8.add (i16x8.mul (local.get $n) (v128.const i16x8 3 3 3 3 3 3 3 3)) (local.get $f)) (v128.const i16x8 8 7 8 7 8 7 8 7)) (i32.const 4)) (v128.const i16x8 128 128 128 128 128 128 128 128)))
(func (export "convert") (param $yp i32) (param $up i32) (param $vp i32) (param $ys i32) (param $us i32) (param $vs i32) (param $dst i32) (param $w i32) (param $h i32)
 (local $step i32) (local $YY v128) (local $UU v128) (local $VV v128) (local $RR v128) (local $GG v128) (local $BB v128) (local $GL v128) (local $GH v128) (local $RG v128) (local $BA v128) (local $out i32) (local $x i32) (local $y i32) (local $cy i32) (local $fy i32) (local $cx i32) (local $fx i32) (local $bias i32) (local $ua i32) (local $ub i32) (local $va i32) (local $vb i32) (local $Y i32) (local $U i32) (local $V i32) (local $R i32) (local $G i32) (local $B i32)
 (block $done (loop $rows
 (br_if $done (i32.ge_u (local.get $y) (local.get $h)))
 (local.set $cy (i32.shr_u (local.get $y) (i32.const 1)))
 (local.set $fy (if (result i32) (i32.and (local.get $y) (i32.const 1)) (then (i32.add (local.get $cy) (i32.const 1))) (else (i32.sub (local.get $cy) (i32.const 1)))))
 (if (i32.lt_s (local.get $fy) (i32.const 0)) (then (local.set $fy (i32.const 0))))
 (if (i32.ge_u (local.get $fy) (i32.shr_u (local.get $h) (i32.const 1))) (then (local.set $fy (i32.sub (i32.shr_u (local.get $h) (i32.const 1)) (i32.const 1)))))
 (local.set $ua (i32.add (local.get $up) (i32.mul (local.get $cy) (local.get $us))))
 (local.set $ub (i32.add (local.get $up) (i32.mul (local.get $fy) (local.get $us))))
 (local.set $va (i32.add (local.get $vp) (i32.mul (local.get $cy) (local.get $vs))))
 (local.set $vb (i32.add (local.get $vp) (i32.mul (local.get $fy) (local.get $vs))))
 (local.set $x (i32.const 0))
 (block $rowdone (loop $cols
 (br_if $rowdone (i32.ge_u (local.get $x) (local.get $w)))
(if (i32.and (i32.ge_u (local.get $w) (i32.const 24)) (i32.and (i32.ge_u (local.get $x) (i32.const 8)) (i32.le_u (local.get $x) (i32.sub (local.get $w) (i32.const 16))))) (then (local.set $cx (i32.shr_u (local.get $x) (i32.const 1)))
(local.set $UU (call $sample8 (local.get $ua) (local.get $ub) (local.get $cx)))
(local.set $VV (call $sample8 (local.get $va) (local.get $vb) (local.get $cx)))
(local.set $YY (i16x8.extend_low_i8x16_u (v128.load64_zero (i32.add (i32.add (local.get $yp) (i32.mul (local.get $y) (local.get $ys))) (local.get $x)))))
(local.set $RR (i16x8.add (local.get $YY) (i16x8.add (local.get $VV) (i16x8.q15mulr_sat_s (local.get $VV) (v128.const i16x8 13173 13173 13173 13173 13173 13173 13173 13173)))))
(local.set $BB (i16x8.add (local.get $YY) (i16x8.add (i16x8.shl (local.get $UU) (i32.const 1)) (i16x8.q15mulr_sat_s (local.get $UU) (v128.const i16x8 -7471 -7471 -7471 -7471 -7471 -7471 -7471 -7471)))))
(local.set $GL (i32x4.shr_s (i32x4.add (i32x4.dot_i16x8_s (i8x16.shuffle 0 1 16 17 2 3 18 19 4 5 20 21 6 7 22 23 (local.get $UU) (local.get $VV)) (v128.const i16x8 -11277 -23401 -11277 -23401 -11277 -23401 -11277 -23401)) (v128.const i32x4 16384 16384 16384 16384)) (i32.const 15)))
(local.set $GH (i32x4.shr_s (i32x4.add (i32x4.dot_i16x8_s (i8x16.shuffle 8 9 24 25 10 11 26 27 12 13 28 29 14 15 30 31 (local.get $UU) (local.get $VV)) (v128.const i16x8 -11277 -23401 -11277 -23401 -11277 -23401 -11277 -23401)) (v128.const i32x4 16384 16384 16384 16384)) (i32.const 15)))
(local.set $GG (i16x8.add (local.get $YY) (i16x8.narrow_i32x4_s (local.get $GL) (local.get $GH))))
(local.set $RR (i8x16.narrow_i16x8_u (local.get $RR) (local.get $RR)))
(local.set $GG (i8x16.narrow_i16x8_u (local.get $GG) (local.get $GG)))
(local.set $BB (i8x16.narrow_i16x8_u (local.get $BB) (local.get $BB)))
(local.set $RG (i8x16.shuffle 0 16 1 17 2 18 3 19 4 20 5 21 6 22 7 23 (local.get $RR) (local.get $GG)))
(local.set $BA (i8x16.shuffle 0 16 1 17 2 18 3 19 4 20 5 21 6 22 7 23 (local.get $BB) (v128.const i32x4 -1 -1 -1 -1)))
(local.set $out (i32.add (local.get $dst) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $w)) (local.get $x)) (i32.const 2))))
(v128.store (local.get $out) (i8x16.shuffle 0 1 16 17 2 3 18 19 4 5 20 21 6 7 22 23 (local.get $RG) (local.get $BA)))
(v128.store (i32.add (local.get $out) (i32.const 16)) (i8x16.shuffle 8 9 24 25 10 11 26 27 12 13 28 29 14 15 30 31 (local.get $RG) (local.get $BA)))
(local.set $step (i32.const 8))) (else  (local.set $cx (i32.shr_u (local.get $x) (i32.const 1)))
 (local.set $fx (if (result i32) (i32.and (local.get $x) (i32.const 1)) (then (i32.add (local.get $cx) (i32.const 1))) (else (i32.sub (local.get $cx) (i32.const 1)))))
 (if (i32.lt_s (local.get $fx) (i32.const 0)) (then (local.set $fx (i32.const 0))))
 (if (i32.ge_u (local.get $fx) (i32.shr_u (local.get $w) (i32.const 1))) (then (local.set $fx (i32.sub (i32.shr_u (local.get $w) (i32.const 1)) (i32.const 1)))))
 (local.set $bias (if (result i32) (i32.and (local.get $x) (i32.const 1)) (then (i32.const 7)) (else (i32.const 8))))
 (local.set $U (i32.sub (call $sample (local.get $ua) (local.get $ub) (local.get $cx) (local.get $fx) (local.get $bias)) (i32.const 128)))
 (local.set $V (i32.sub (call $sample (local.get $va) (local.get $vb) (local.get $cx) (local.get $fx) (local.get $bias)) (i32.const 128)))
 (local.set $Y (i32.load8_u (i32.add (i32.add (local.get $yp) (i32.mul (local.get $y) (local.get $ys))) (local.get $x))))
 (local.set $R (call $clip (i32.add (local.get $Y) (i32.shr_s (i32.add (i32.mul (i32.const 91881) (local.get $V)) (i32.const 32768)) (i32.const 16)))))
 (local.set $G (call $clip (i32.add (local.get $Y) (i32.shr_s (i32.add (i32.add (i32.mul (i32.const -22554) (local.get $U)) (i32.mul (i32.const -46802) (local.get $V))) (i32.const 32768)) (i32.const 16)))))
 (local.set $B (call $clip (i32.add (local.get $Y) (i32.shr_s (i32.add (i32.mul (i32.const 116130) (local.get $U)) (i32.const 32768)) (i32.const 16)))))
 (i32.store (i32.add (local.get $dst) (i32.shl (i32.add (i32.mul (local.get $y) (local.get $w)) (local.get $x)) (i32.const 2))) (i32.or (i32.const -16777216) (i32.or (local.get $R) (i32.or (i32.shl (local.get $G) (i32.const 8)) (i32.shl (local.get $B) (i32.const 16))))))
(local.set $step (i32.const 1))))
 (local.set $x (i32.add (local.get $x) (local.get $step))) (br $cols)))
 (local.set $y (i32.add (local.get $y) (i32.const 1))) (br $rows))))
)