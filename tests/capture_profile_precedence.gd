extends SceneTree
func _initialize():
 var view=load("res://godot/runtime/point_cloud/unified_point_cloud_view.gd").new()
 OS.set_environment("ROBOT_TELEOP_CAPTURE_ONLY","1")
 view.set("_remote_capture_profile","highres30")
 view.set("_capture_control_settings",{"camera":{"stream_profile":"fast60"}})
 assert(view.call("_realsense_setting","camera","stream_profile","viewer30")=="fast60")
 assert(view.call("get_remote_stream_preset")=="latency")
 view.set("_capture_control_settings",{"camera":{"stream_profile":"highres30"}})
 assert(view.call("_realsense_setting","camera","stream_profile","viewer30")=="highres30")
 assert(view.call("get_remote_stream_preset")=="quality")
 view.set("_capture_control_settings",{"a":{"stream_profile":"fast60"},"b":{"stream_profile":"highres30"}})
 assert(view.call("get_remote_stream_preset")=="custom")
 view.set("_capture_control_settings",{})
 assert(view.call("_realsense_setting","camera","stream_profile","viewer30")=="highres30")
 OS.set_environment("ROBOT_TELEOP_CAPTURE_ONLY","")
 view.set("_remote_capture_profile","fast60")
 assert(view.call("_realsense_setting","camera","stream_profile","viewer30")=="fast60")
 view.free()
 print("PROFILE_PRECEDENCE_OK: seven startup/live preset and diagnostic checks; no cameras opened")
 quit()
